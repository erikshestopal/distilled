{
  "description": "On 2026-11-09 repeated GET and DELETE probes for an absent service query endpoint on an existing disposable service returned HTTP 404 with error 'NOT_FOUND: Not Found'. Both operations against an absent parent instead returned 'NOT_FOUND: <service-id>'. Match only the observed exact child message on those two operations.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.clickhouse.service#ServiceQueryEndpointNotFound",
      "value": {
        "type": "structure",
        "members": { "message": { "target": "smithy.api#String" } },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "com.distilled.openapi#errorMatchers": [
            { "status": 404, "message": "NOT_FOUND: Not Found" }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.clickhouse.service#InstanceQueryEndpointGet/errors/-",
      "value": { "target": "com.clickhouse.service#ServiceQueryEndpointNotFound" }
    },
    {
      "op": "add",
      "path": "/shapes/com.clickhouse.service#InstanceQueryEndpointDelete/errors/-",
      "value": { "target": "com.clickhouse.service#ServiceQueryEndpointNotFound" }
    }
  ]
}
